      "id": "q_mi_lit_1",
      "type": "multiple_choice",
      "text": "Apa ide pokok paragraf tersebut?",
      "stimulus": "Kebun Sekolah\nSetiap hari Jumat, siswa MI Islamiyah bekerja bakti di kebun sekolah. Mereka menanam sawi, bayam, dan cabai. Pak Rahmat, guru kelas, mengajari cara menyiram dan memberi pupuk. Hasil panen dijual di kantin dengan harga murah. Uang penjualannya dipakai untuk membeli buku bacaan di perpustakaan.",
      "options": [
        {
          "id": "A",
          "text": "Kegiatan kerja bakti siswa di kebun sekolah"
        },
        {
          "id": "B",
          "text": "Cara menanam cabai yang benar"
        },
        {
          "id": "C",
          "text": "Harga sawi di kantin sekolah"
        },
        {
          "id": "D",
          "text": "Perpustakaan sekolah yang baru"
        }
      ],
      "answerKey": [
        "A"
      ],
      "score": 1,
      "createdAt": "2026-11-01T08:14:28.214Z",
      "packetId": "pkt_mi_lit"
